  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5C5A52", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": { "foreground": "#7A776E", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name", "support.variable", "entity.name.variable"],
      "settings": { "foreground": "#D0CFC8" }
    },
    {
      "scope": ["variable.language", "variable.other.constant.object", "variable.parameter.function.language.special"],
      "settings": { "foreground": "#D97757" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#D9A48C" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.expression", "keyword.operator.new", "keyword.operator.logical"],
      "settings": { "foreground": "#B07CC5" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#D9A48C" }
    },
    {
      "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#B07CC5" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#6A9BCC" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "entity.name.scope-resolution"],
      "settings": { "foreground": "#6EB4BF" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#D97757" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#6A9BCC" }
    },
    {
      "scope": ["entity.name.function.constructor", "support.type.object.module"],
      "settings": { "foreground": "#6A9BCC" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string", "meta.embedded.assembly"],
      "settings": { "foreground": "#8FA876" }
    },
    {
      "scope": ["constant.character.escape", "constant.character.string.escape"],
      "settings": { "foreground": "#7A776E" }
    },
    {
      "scope": ["string.regexp", "constant.regexp", "keyword.control.anchor.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#D4B06A" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "keyword.other.unit"],
      "settings": { "foreground": "#D4B06A" }
    },
    {
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#D4B06A" }
    },
    {
      "scope": ["variable.other.enummember", "constant.other.enum"],
      "settings": { "foreground": "#D9A48C" }
    },
    {
      "scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property", "variable.other.object.property"],
      "settings": { "foreground": "#D97757" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#B0AEA5" }
    },
    {
      "scope": ["entity.name.label", "constant.other.label"],
      "settings": { "foreground": "#6A9BCC" }
    },
    {
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "source.css entity.name.tag"],
      "settings": { "foreground": "#8FA876" }
    },
    {
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#6A9BCC" }
    },
    {
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": { "foreground": "#D97757" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#D97757", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#D97757", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#D9A48C", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#8FA876" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6EB4BF" }
    },
    {
      "scope": ["markup.list", "punctuation.definition.list.begin", "beginning.punctuation.definition.list"],
      "settings": { "foreground": "#D97757" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#B0AEA5", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8FA876" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#D07277" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#D4B06A" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D07277" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#D4B06A", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#D9A48C",
    "property": "#D97757",
    "enumMember": "#D9A48C",
    "namespace": "#D0CFC8",
    "type": "#6EB4BF",
    "class": "#6EB4BF",
    "interface": "#6EB4BF",
    "enum": "#6EB4BF",
    "function": "#6A9BCC",
    "method": "#6A9BCC",
    "variable.readonly": "#D4B06A",
    "variable.defaultLibrary": "#D97757"
  }
}
